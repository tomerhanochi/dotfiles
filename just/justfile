set default-script
set script-interpreter := ['bash', '-euo', 'pipefail']

ssh_directory := home_directory() / ".ssh"
ssh_config_file := ssh_directory / "config"
ssh_keys_directory := ssh_directory / "keys"

# Configure .ssh directory and config file.
ssh-configure:
  mkdir -p '{{ ssh_directory }}' '{{ ssh_keys_directory }}'
  chmod 700 '{{ ssh_directory }}' '{{ ssh_keys_directory }}'
  SSH_CONFIG=$(
  cat << 'EOF'
  # Keep this Include at the very bottom of the file.
  # ssh is first-match-wins, so these defaults silently override any Host block below.
  Include ~/.config/ssh_config.d/defaults.conf
  EOF
  )
  if ! grep -Fzq "$SSH_CONFIG" '{{ ssh_config_file }}'; then
      printf "\n%s" "$SSH_CONFIG" >> '{{ ssh_config_file }}'
  fi

# Create a Secure Enclave (bio-protected) SSH key in the keychain under a common name
ssh-create name:
    timestamp="$(date +'%Y-%m-%dT%H-%M-%S')"
    sc_auth create-ctk-identity -N '{{ name }}' -l "${timestamp}" -k p-256-ne -t bio

# Export Secure Enclave SSH keys into ~/.ssh/keys/<common-name>/, pointing `current` at the newest
ssh-export:
    hash_pubkey() {
      cat "$1" | ssh-keygen -lf - | grep -o 'SHA256:\S*'
    }

    extract_ctk_identity() {
      sc_auth list-ctk-identities -t ssh -e b64 | grep "$1"
    }

    keycount="$(sc_auth list-ctk-identities -t ssh -e b64 | tail -n +2 | wc -l | tr -d '[:space:]')"
    tmpdir="$(mktemp -d)"
    trap 'rm -rf "${tmpdir}"' EXIT

    (
      cd "${tmpdir}"
      for i in $(seq 0 "${keycount}"); do
        {
          if [ "${i}" -ne 0 ]; then yes y | head -n "${i}"; fi
          if [ "${i}" -ne "${keycount}" ]; then yes n | head -n "$((keycount - i))"; fi
        } | SSH_ASKPASS_REQUIRE=force SSH_ASKPASS=echo ssh-keygen -w /usr/lib/ssh-keychain.dylib -K -N "" &> /dev/null || true

        public_key_path="$(find . -type f -name '*.pub')"
        public_key_hash="$(hash_pubkey "${public_key_path}")"
        private_key_path="$(find . -type f -not -name '*.pub')"

        ctk_identity="$(extract_ctk_identity "${public_key_hash}")"
        # Key Type | Public Key Hash | Prot | Label | Common Name | Email Address | Valid To | Valid
        ctk_identity_cn="$(echo "${ctk_identity}" | awk '{print $5}')"
        ctk_identity_label="$(echo "${ctk_identity}" | awk '{print $4}')"

        directory="{{ ssh_keys_directory }}/${ctk_identity_cn}"
        mkdir -p "${directory}"
        chmod 700 "${directory}"
        mv "${public_key_path}" "${directory}/${ctk_identity_label}.pub"
        mv "${private_key_path}" "${directory}/${ctk_identity_label}"
      done
    )

    # Point `current` at the newest label in each exported identity directory. Labels are
    # `%Y-%m-%dT%H-%M-%S` timestamps, so a lexicographic sort is chronological.
    find '{{ ssh_keys_directory }}' -type f -name '*.pub' -exec dirname {} ';' | sort -u | while read -r directory; do
      latest="$(find "${directory}" -maxdepth 1 -type f ! -name '*.pub' ! -name 'current' -exec basename {} ';' | sort | tail -n1)"
      [ -n "${latest}" ] || continue
      ln -sf "${latest}" "${directory}/current"
      ln -sf "${latest}.pub" "${directory}/current.pub"
    done

serve-llm model ctx temperature top_p port kv_quantization:
    llama-server \
        -hf "{{model}}" \
        -c "{{ctx}}" \
        --port "{{port}}" \
        --temp "{{temperature}}" \
        --top-p "{{top_p}}" \
        --no-mmproj \
        -ngl 99 \
        -fa on \
        -ctk "{{ kv_quantization }}" \
        -ctv "{{ kv_quantization }}"

serve-qwen port="8080": (serve-llm "unsloth/Qwen3.6-35B-A3B-GGUF:UD-Q4_K_XL" "65536" "0.15" "0.8" port "q8_0")
